# Copy this file to .env and fill in your own project's values.
# Find these in the Supabase dashboard: Project Settings -> API.

# Project URL, looks like https://xxxxxxxx.supabase.co
SUPABASE_URL= https://pmnkxgfbrxulgmygteeg.supabase.co

# The "service_role" key -- NOT the "anon" key. This key bypasses Row Level
# Security and must never reach the browser or a public repo. It belongs on
# the server only (and, when deploying, in Render's environment variables,
# not committed to git).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBtbmt4Z2Zicnh1bGdteWd0ZWVnIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4OTkxNzQ3MiwiZXhwIjoyMTA1NDkzNDcyfQ.5fhGiaEv37u8cGLZ7Kk173MiRXZbQtS8Y-OUb6yIlGo

# Local dev port. Leave unset in most deploy targets -- Render sets its own.
PORT=4000

# The deployed client's URL, e.g. https://tokimap.vercel.app
# Leave unset locally; cors() falls back to allowing any origin in dev.
CLIENT_ORIGIN=